# Скопируй как .env и заполни реальными значениями
# cp .env.example .env

# PostgreSQL (порт 5433 — pgvector docker)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=uni
DB_USER=app
DB_PASS=app

# Приложение
DEBUG=true
APP_NAME=uni-reco

# Gemini LLM (для RAG-чата)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite
RAG_LLM_PROVIDER=gemini

# JWT
JWT_SECRET=change-me-to-a-long-random-string

# Email (опционально — для сброса пароля)
MAIL_USERNAME=
APP_PASSWORD=
MAIL_FROM=
